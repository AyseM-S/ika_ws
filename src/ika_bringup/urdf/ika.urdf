<?xml version="1.0"?>
<!-- GORSEL PLACEHOLDER MODEL - gercek mekanik CAD gelince tum olculer
     (govde boyutu, tekerlek konumlari, sensor yerlesimi) guncellenecek.
     Amac: RViz'de taninabilir bir 6 tekerlekli arac silueti gostermek. -->
<robot name="ika">
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="orange"><color rgba="0.9 0.4 0.1 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.5 0.35 0.15"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <link name="imu_link">
    <visual><geometry><box size="0.03 0.03 0.01"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="gps_link">
    <visual><geometry><cylinder radius="0.03" length="0.02"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="-0.15 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="black"/></visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="0.15 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- 6 teker - SADECE GORSEL (fixed joint, fizik yok). Konumlar TAHMINI:
       track_width=0.40 (mevcut placeholder), wheelbase TAHMINI 0.40 -->
  <link name="wheel_fl"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>
  <link name="wheel_fr"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>
  <link name="wheel_ml"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>
  <link name="wheel_mr"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>
  <link name="wheel_rl"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>
  <link name="wheel_rr"><visual><geometry><cylinder radius="0.065" length="0.05"/></geometry><material name="black"/></visual></link>

  <joint name="j_fl" type="fixed"><parent link="base_link"/><child link="wheel_fl"/><origin xyz="0.20 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_fr" type="fixed"><parent link="base_link"/><child link="wheel_fr"/><origin xyz="0.20 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_ml" type="fixed"><parent link="base_link"/><child link="wheel_ml"/><origin xyz="0.0 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_mr" type="fixed"><parent link="base_link"/><child link="wheel_mr"/><origin xyz="0.0 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_rl" type="fixed"><parent link="base_link"/><child link="wheel_rl"/><origin xyz="-0.20 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_rr" type="fixed"><parent link="base_link"/><child link="wheel_rr"/><origin xyz="-0.20 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
</robot>
