<?xml version="1.0"?>
<!-- GORSEL PLACEHOLDER MODEL - gercek mekanik CAD gelince olculer guncellenecek.
     v2: collision + inertial bloklari eklendi (RobotModel render sorunu teshisi icin).
     Material tanimlari link icine tasindi. -->
<robot name="ika">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.35 0.15"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.35 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="orange"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.03 0.01"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="gps_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="orange2"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="-0.15 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision>
    <inertial><mass value="0.19"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/>
    <origin xyz="0.15 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="wheel_fl">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>
  <link name="wheel_fr">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack2"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>
  <link name="wheel_ml">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack3"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>
  <link name="wheel_mr">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack4"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>
  <link name="wheel_rl">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack5"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>
  <link name="wheel_rr">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry>
      <material name="wheelblack6"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.065" length="0.05"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
  </link>

  <joint name="j_fl" type="fixed"><parent link="base_link"/><child link="wheel_fl"/><origin xyz="0.20 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_fr" type="fixed"><parent link="base_link"/><child link="wheel_fr"/><origin xyz="0.20 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_ml" type="fixed"><parent link="base_link"/><child link="wheel_ml"/><origin xyz="0.0 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_mr" type="fixed"><parent link="base_link"/><child link="wheel_mr"/><origin xyz="0.0 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_rl" type="fixed"><parent link="base_link"/><child link="wheel_rl"/><origin xyz="-0.20 0.20 -0.05" rpy="1.5708 0 0"/></joint>
  <joint name="j_rr" type="fixed"><parent link="base_link"/><child link="wheel_rr"/><origin xyz="-0.20 -0.20 -0.05" rpy="1.5708 0 0"/></joint>
</robot>
